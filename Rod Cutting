class Solution {
    int helper(int index,int target,int[] price,int[][] dp){
        
        if(index==0){
            return target*price[0];
        }
        
        if(dp[index][target]!=-1)return dp[index][target];
        
        
        int nottake=helper(index-1,target,price,dp);
        int take=Integer.MIN_VALUE;
        int rodlen=index+1;
        if(rodlen<=target){
            take=price[rodlen-1]+helper(index,target-rodlen,price,dp);
        }
        
        return dp[index][target]=Math.max(nottake,take);
    }
    
    public int cutRod(int[] price) {
        // code here
        int n=price.length;
        int[][] dp=new int[n][n+1];
        for(int i=0;i<n;i++){
            Arrays.fill(dp[i],-1);
        }
        return helper(n-1,n,price,dp);
    }
}
